# -------------------------------------------------------
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# -------------------------------------------------------

# Google AI Studio — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=api_key_here
# Vertex AI settings for Google Cloud billing/credits
GCP_PROJECT_ID=a
GCP_LOCATION=a
# Any hard-to-guess string used to protect the /hackrx/run endpoint
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
BEARER_TOKEN=bearer_token_here

# Optional — change the Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional — change the embedding model (default: all-MiniLM-L6-v2)
# EMBED_MODEL=all-MiniLM-L6-v2

# Optional — chunking parameters
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
